__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
dist/
build/
site/
*.egg-info/

# Agent skill folders, as in PyFLASH and CircadianWorkbench. `.codex/skills/`
# holds junctions into the global shared-skills folder; committing them would
# duplicate the global copy into this repo.
/.claude/
/.codex/

# Imaging outputs and anything a run writes. A single OME-TIFF is larger than
# this whole repository, so the rule is: source and small fixtures only.
/.pymicroglia/
/AI_Exports/
/Results/
/Exports/
*.vsi
*.ome.tif
*.ome.tiff
*.nd2
*.lif
*.avi
*.mp4
*.mov

# The development tree: the working record of an analysis while it is being
# proved -- its code, its round write-ups, its chosen settings and its evidence
# tables. The evidence itself is imaging output and obeys the rule above, so the
# folder is kept but its pictures, weights and movies are not. What stays in the
# repository is the part a person reads.
/development/**/*.tif
/development/**/*.tiff
/development/**/*.pt
/development/**/*.png
/development/**/*.zip
/development/**/*.reprofig
/development/**/rounds/
/development/**/runs/
/development/**/predictions/

# ...except the test fixtures, which are deliberately tiny. The cosmic-ray
# reference includes a 40 KB synthetic_registered.ome.tif that the filtering
# parity test reads; without this exemption the rule above would silently
# exclude it and the test would fail on a fresh clone rather than here.
# The whole tests/fixtures tree is well under a megabyte. Keep it that way:
# anything large enough to be real data does not belong in the repository.
!tests/fixtures/**

# Rebuilt from the code by a commit hook; never read from the repository.
graphify-out/
